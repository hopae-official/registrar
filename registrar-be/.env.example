# App
PORT=
STAGE=

# Logging
LOG_LEVEL=

# Auth
JWT_SECRET=

# Server URLs
HOST=
API_BASE_URL=

# Certificates
CONFIG_FOLDER=

# Persistent CA (PEM). Set both so the CA survives restarts and matches the published Trusted List anchor;
# unset ⇒ an ephemeral CA is generated (dev only). Served at /registrar/ca-certificate(.der).
REGISTRAR_CA_CERT=
REGISTRAR_CA_KEY=
